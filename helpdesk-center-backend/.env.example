# ── Copy this file and fill in your values ────────────────────────────────
# This file is NOT loaded by Spring Boot directly — it is a reference sheet
# for the environment variables you must set in Render's dashboard.
# ──────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL — use the JDBC URL WITHOUT user= and password= in the URL
DB_URL=jdbc:postgresql://ep-restless-sea-aoij8sc9-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here

# JWT — must be 64+ characters
JWT_SECRET=helpdesk-center-super-secret-jwt-signing-key-that-is-at-least-64-characters-long!

# IBM Watson NLU
WATSON_API_KEY=your_watson_api_key_here
WATSON_URL=https://api.jp-tok.natural-language-understanding.watson.cloud.ibm.com/instances/your_instance_id

# CORS — set to your Vercel frontend URL after deploying (e.g. https://helpdesk-center.vercel.app)
# During initial Render setup before Vercel is deployed, leave as localhost
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ── Email (SMTP) ──────────────────────────────────────────
# Gmail example: use an App Password, not your normal password
# Render: add these as individual environment variables
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=no-reply@helpdesk.local

# ── App base URL (used in email links) ────────────────────
# Set to your Vercel frontend URL so ticket links in emails resolve correctly
APP_BASE_URL=https://your-app.vercel.app
